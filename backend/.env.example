DEBUG=true
# —— 本机 PostgreSQL（默认端口 5432）——
# 将用户名、密码改为本机实际账号；库名需先在 pgAdmin / psql 中建好空库 uli_dev
DATABASE_URL=postgresql+psycopg://postgres:你的密码@localhost:5432/uli_dev
REDIS_URL=redis://localhost:6379/0
KIMI_API_KEY=replace_with_new_key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_TEXT_MODEL=kimi-k2.5
KIMI_VISION_MODEL=moonshot-v1-vision-preview

# —— 可选：使用 backend/docker-compose.yml 时改为（本机映射 5433 / 6380）——
# DATABASE_URL=postgresql+psycopg://postgres:pass@localhost:5433/uli_dev
# REDIS_URL=redis://localhost:6380/0

SECRET_KEY=change-me

# 前端联调（Vite 默认 5173）；留空则不启用 CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT
JWT_ALGORITHM=HS256

# Token 过期时间（分钟/天）
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# 连接 PostgreSQL 超时（秒），避免迁移长时间无响应；默认 15
# DB_CONNECT_TIMEOUT_SECONDS=15
