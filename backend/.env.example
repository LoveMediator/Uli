DEBUG=true
# 使用 backend/docker-compose.yml 时（本机端口 5433 / 6380）：
DATABASE_URL=postgresql+psycopg://postgres:pass@localhost:5433/lovemediator_dev
REDIS_URL=redis://localhost:6380/0
# 若使用本机已安装的 PostgreSQL（默认 5432），改为例如：
# DATABASE_URL=postgresql+psycopg://你的用户名:你的密码@localhost:5432/lovemediator_dev
# REDIS_URL=redis://localhost:6379/0

SECRET_KEY=change-me

# 前端联调（Vite 默认 5173）；留空则不启用 CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT
JWT_ALGORITHM=HS256

# Token 过期时间（分钟/天）
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# 连接 PostgreSQL 超时（秒），避免迁移长时间无响应；默认 15
# DB_CONNECT_TIMEOUT_SECONDS=15
